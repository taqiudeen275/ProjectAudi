{
  "name": "audilink-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "audilink",
    "audilink-books",
    "audilink-admin",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev:studio": "bun run --cwd audilink dev",
    "dev:books": "bun run --cwd audilink-books dev",
    "dev:admin": "bun run --cwd audilink-admin dev",
    "dev:api": "bun run --cwd services/control-api dev",
    "lint": "bun run --workspaces --if-present --parallel lint",
    "typecheck": "bun run --workspaces --if-present --parallel typecheck",
    "test": "bun run --workspaces --if-present --parallel test",
    "build": "bun run --workspaces --if-present --parallel build",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build"
  }
}
